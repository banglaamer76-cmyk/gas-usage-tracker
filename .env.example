# Copy to .env.local and fill in the values.

# MongoDB connection string
MONGODB_URI=

# The app's public URL, and a long random secret (e.g. `openssl rand -base64 32`)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Google OAuth client: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: comma-separated Google accounts allowed to sign in. Empty = any Google account.
ALLOWED_EMAILS=

# Comma-separated Google accounts that can change the cylinder change date (everyone can see it).
# Empty = nobody can change it.
CYLINDER_EDITORS=
